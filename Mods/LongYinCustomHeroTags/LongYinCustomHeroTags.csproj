<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>LongYinCustomHeroTags</AssemblyName>
    <RootNamespace>LongYinCustomHeroTags</RootNamespace>
    <OutputPath>$(ArtifactsDir)bin\$(MSBuildProjectName)\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <PackageTempDir>$(BaseIntermediateOutputPath)package\</PackageTempDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(GameRootPath)MelonLoader\net6\MelonLoader.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameRootPath)MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameRootPath)MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameRootPath)MelonLoader\net6\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameRootPath)MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(GameRootPath)MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- 在构建时从 Main.cs 的 MelonInfo 特性里提取版本号 -->
  <UsingTask TaskName="ReadModVersion" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFile ParameterType="System.String" Required="true" />
      <ModVersion ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          string content = File.ReadAllText(SourceFile);
          var match = Regex.Match(content,
              @"MelonInfo\s*\([^,]+,\s*""[^""]*""\s*,\s*""([^""]+)""",
              RegexOptions.Singleline);
          ModVersion = match.Success ? match.Groups[1].Value : "0.0.0";
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="PackageBuildOutput" AfterTargets="Build">
    <MakeDir Directories="$(ArtifactsDir)packages" />
    <!-- 读取 Main.cs 里 MelonInfo 版本号 -->
    <ReadModVersion SourceFile="$(MSBuildProjectDirectory)\Main.cs">
      <Output TaskParameter="ModVersion" PropertyName="ModVersion" />
    </ReadModVersion>
    <PropertyGroup>
      <PackageZipPath>$(ArtifactsDir)packages\LongYinCustomHeroTags-v$(ModVersion).zip</PackageZipPath>
    </PropertyGroup>
    <ItemGroup>
      <PackageFiles Include="$(TargetPath)" />
      <PackageFiles Include="$(MSBuildProjectDirectory)\README.txt" />
    </ItemGroup>
    <RemoveDir Directories="$(PackageTempDir)" />
    <MakeDir Directories="$(PackageTempDir)" />
    <Copy SourceFiles="@(PackageFiles)" DestinationFolder="$(PackageTempDir)" />
    <Delete Files="$(PackageZipPath)" Condition="Exists('$(PackageZipPath)')" />
    <ZipDirectory SourceDirectory="$(PackageTempDir)" DestinationFile="$(PackageZipPath)" Overwrite="true" />
    <RemoveDir Directories="$(PackageTempDir)" />
    <Message Text="打包完成：$(PackageZipPath)" Importance="high" />
  </Target>
</Project>
