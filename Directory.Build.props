<Project>
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <ArtifactsDir>$(RepositoryRoot)Artifacts\</ArtifactsDir>
    <Authors>SaintCirno9</Authors>
    <DeployMods Condition="'$(DeployMods)' == ''">true</DeployMods>
  </PropertyGroup>
  <Import Project="$(RepositoryRoot)GamePaths.props" />
  <ItemGroup>
    <ModLicenseFiles Include="$(RepositoryRoot)LICENSE" />
  </ItemGroup>
  <PropertyGroup>
    <GameRootPath>$([MSBuild]::EnsureTrailingSlash('$(GameRootDir)'))</GameRootPath>
  </PropertyGroup>
</Project>
