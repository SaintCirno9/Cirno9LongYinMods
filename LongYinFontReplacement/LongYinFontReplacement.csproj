<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>LongYinFontReplacement</AssemblyName>
    <RootNamespace>LongYinFontReplacement</RootNamespace>
    <OutputPath>..\\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <PackageTempDir>$(BaseIntermediateOutputPath)package\</PackageTempDir>
    <PackageZipPath>$(MSBuildProjectDirectory)\LongYinFontReplacement.zip</PackageZipPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>..\..\MelonLoader\net6\MelonLoader.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>..\..\MelonLoader\Il2CppAssemblies\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\..\MelonLoader\Il2CppAssemblies\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\..\MelonLoader\net6\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>..\..\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>..\..\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <UsingTask TaskName="ReadModVersion" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFile ParameterType="System.String" Required="true" />
      <ModVersion ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          string content = File.ReadAllText(SourceFile);
          var match = Regex.Match(content, @"MelonInfo\(.*?,\s*""[^""]*""\s*,\s*""([^""]+)""");
          ModVersion = match.Success ? match.Groups[1].Value : "1.0.0";
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="PackageBuildOutput" AfterTargets="Build">
    <ReadModVersion SourceFile="$(MSBuildProjectDirectory)\Main.cs">
      <Output TaskParameter="ModVersion" PropertyName="ModVersion" />
    </ReadModVersion>
    <PropertyGroup>
      <PackageZipPath>$(MSBuildProjectDirectory)\LongYinFontReplacement-v$(ModVersion).zip</PackageZipPath>
      <PackageModsDir>$(PackageTempDir)Mods\</PackageModsDir>
      <PackageUserDataDir>$(PackageTempDir)UserData\LongYinFontReplacement\</PackageUserDataDir>
    </PropertyGroup>
    <ItemGroup>
      <PackageUserDataFiles Include="$(MSBuildProjectDirectory)\..\..\UserData\LongYinFontReplacement\**\*.*" Exclude="$(MSBuildProjectDirectory)\..\..\UserData\LongYinFontReplacement\RuntimeFonts\**\*.*" />
    </ItemGroup>
    <RemoveDir Directories="$(PackageTempDir)" />
    <MakeDir Directories="$(PackageModsDir)" />
    <MakeDir Directories="$(PackageUserDataDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageModsDir)" />
    <Copy SourceFiles="@(PackageUserDataFiles)" DestinationFolder="$(PackageUserDataDir)%(RecursiveDir)" />
    <Delete Files="$(PackageZipPath)" Condition="Exists('$(PackageZipPath)')" />
    <ZipDirectory SourceDirectory="$(PackageTempDir)" DestinationFile="$(PackageZipPath)" Overwrite="true" />
    <RemoveDir Directories="$(PackageTempDir)" />
    <Message Text="打包完成：$(PackageZipPath)" Importance="high" />
  </Target>
</Project>
